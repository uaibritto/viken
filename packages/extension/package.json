{
  "name": "viken",
  "displayName": "Viken",
  "version": "0.2.0",
  "description": "Syntax highlighting and IntelliSense for Viken files (.vk, .viken)",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "cursor",
    "dsl",
    "snippets",
    "viken",
    "vikyn/viken",
    "vscode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uaibritto/viken",
    "directory": "packages/extension"
  },
  "publisher": "uaibritto",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsdown",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "viken",
        "aliases": [
          "Viken",
          "viken"
        ],
        "extensions": [
          ".vk",
          ".viken"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/viking-helmet.svg",
          "dark": "./icons/viking-helmet.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "viken",
        "scopeName": "source.viken",
        "path": "./syntaxes/viken.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.tsx": "typescriptreact"
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:viken"
  ],
  "icon": "./icon.png",
  "engines": {
    "vscode": "^1.75.0"
  }
}
