{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "vscode"]
    },
    "include": ["src"]
}
