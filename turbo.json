{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
